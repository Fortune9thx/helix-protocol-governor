# Copy to .env and fill in before running scripts/deploy.ts.
# Vite only exposes variables prefixed with VITE_ to the browser.
#
# Contract addresses are NOT set here anymore - scripts/deploy.ts writes
# them to addresses.json at the repo root, which the frontend imports
# directly. That's the one source of truth; .env only carries chain/network
# config and secrets.

# Which GenLayer chain the app talks to: studioDevnet | studionet | testnetBradbury
# HELIX targets studio-dev (consensus v0.6 RC, chain 61997) only - see
# https://docs.genlayer.com/developers/consensus-v06-migration
VITE_GENLAYER_CHAIN=studioDevnet

# Optional. Powers the WalletConnect QR flow in the RainbowKit connect
# modal. Get one free at https://cloud.reown.com. Injected wallets
# (MetaMask, etc.) connect fine without it - a placeholder id is used
# automatically when this is unset.
VITE_WALLETCONNECT_PROJECT_ID=

# Helper placeholder text shown in the Dossier's alarm-URL fields - not
# prefilled values, since raise_alarm should be filed against a URL the
# caller actually chose. These must be reachable by GenLayer validators over
# the public internet - GitHub raw / Pages / a raw gist. Local paths and
# localhost will not work.
VITE_EVIDENCE_DRAIN_URL=https://raw.githubusercontent.com/Fortune9thx/helix-protocol-governor/main/evidence/drain-advisory.html
VITE_EVIDENCE_PHISH_URL=https://raw.githubusercontent.com/Fortune9thx/helix-protocol-governor/main/evidence/phishing-kit.html

# scripts/deploy.ts only, never prefixed with VITE_ so it's never bundled
# into the client.
DEPLOYER_PRIVATE_KEY=

# Optional. Reuse an already-live GenomeRegistry instead of deploying a
# fresh one - the script verifies it's actually readable before trusting it.
EXISTING_GENOME_REGISTRY=
