# Copy to .env and fill in after deploying the contracts.
# Vite only exposes variables prefixed with VITE_ to the browser.

# Which GenLayer chain the app talks to: testnetBradbury | studionet
VITE_GENLAYER_CHAIN=testnetBradbury

# Contract addresses, printed by `npm run deploy:helix`
VITE_HOST_VAULT_ADDRESS=
VITE_HELIX_ADDRESS=
VITE_GENOME_REGISTRY_ADDRESS=

# Evidence pages the jury fetches. These must be reachable by GenLayer
# validators over the public internet - GitHub raw / Pages / a raw gist.
# Local paths and localhost will not work.
VITE_EVIDENCE_DRAIN_URL=https://raw.githubusercontent.com/Fortune9thx/helix-protocol-governor/main/evidence/drain-advisory.html
VITE_EVIDENCE_PHISH_URL=https://raw.githubusercontent.com/Fortune9thx/helix-protocol-governor/main/evidence/phishing-kit.html

# Deployer key, used only by scripts/deploy.ts. Never prefixed with VITE_,
# so it is never bundled into the client.
DEPLOYER_PRIVATE_KEY=
